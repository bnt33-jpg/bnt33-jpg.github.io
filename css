/* Brandon Ton Portfolio — main stylesheet */
:root {
  --rutgers-red: #c03a3a;
  --rutgers-red-dark: #9f2f2f;
  --ink: #111827;
  --navy: #11172b;
  --muted: #626a78;
  --page: #f5f6f8;
  --white: #ffffff;
  --line: #e5e7eb;
  --soft-red: #f6e3e3;
  --soft-red-text: #9e5a5a;
  --shadow: 0 16px 40px rgba(17, 24, 39, 0.08);
  --radius: 22px;
  --container: 1120px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: var(--ink);
  background: var(--page);
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  display: block;
  max-width: 100%;
}

.container {
  width: min(var(--container), calc(100% - 40px));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(17, 24, 39, 0.06);
}

.nav {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 14px;
  font-weight: 800;
}

.brand-mark {
  color: var(--rutgers-red);
  font-size: 1.7rem;
  font-weight: 900;
  letter-spacing: -0.06em;
}

.brand-title {
  border-left: 1px solid #d6d8dc;
  padding-left: 14px;
  font-size: 1.05rem;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 27px;
  font-size: 0.94rem;
  font-weight: 650;
  color: #434957;
}

.nav-links > a:not(.resume-button):hover {
  color: var(--rutgers-red);
}

.resume-button,
.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-weight: 750;
  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.resume-button {
  padding: 12px 21px;
  background: var(--navy);
  color: var(--white);
  box-shadow: 0 10px 24px rgba(17, 23, 43, 0.16);
}

.resume-button:hover,
.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-1px);
}

.hero {
  padding: 92px 0 100px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 300px minmax(0, 1fr);
  align-items: center;
  gap: 78px;
}

.profile-panel {
  text-align: center;
}

.photo-ring {
  width: 185px;
  height: 185px;
  margin: 0 auto 23px;
  padding: 6px;
  border-radius: 50%;
  background: var(--white);
  box-shadow: var(--shadow);
}

.headshot {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  object-position: center 28%;
}

.profile-name {
  margin: 0 0 5px;
  font-size: 1.85rem;
  line-height: 1.15;
  font-weight: 900;
  letter-spacing: -0.03em;
}

.profile-school {
  margin: 0;
  color: var(--rutgers-red);
  font-weight: 800;
}

.profile-class {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 0.94rem;
}

.status-pill {
  display: inline-block;
  margin-bottom: 20px;
  padding: 7px 13px;
  border-radius: 999px;
  color: var(--soft-red-text);
  background: var(--soft-red);
  font-size: 0.83rem;
  font-weight: 750;
}

.hero-copy h1 {
  margin: 0 0 22px;
  max-width: 800px;
  color: var(--navy);
  font-size: clamp(3.1rem, 5.2vw, 5.15rem);
  line-height: 0.98;
  letter-spacing: -0.065em;
  font-weight: 900;
}

.hero-intro {
  max-width: 780px;
  margin: 0;
  color: var(--muted);
  font-size: clamp(1.06rem, 1.6vw, 1.25rem);
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 30px;
}

.primary-button {
  padding: 13px 23px;
  background: var(--white);
  border: 1px solid var(--line);
  box-shadow: 0 7px 20px rgba(17, 24, 39, 0.04);
}

.text-link {
  font-weight: 750;
  color: #444b59;
}

.text-link:hover {
  color: var(--rutgers-red);
}

.section {
  padding: 88px 0;
}

.white-section {
  background: var(--white);
}

.section-heading {
  max-width: 780px;
  margin-bottom: 32px;
}

.section-heading h2 {
  margin: 0 0 12px;
  color: var(--navy);
  font-size: clamp(2rem, 3vw, 3rem);
  line-height: 1.08;
  letter-spacing: -0.045em;
  font-weight: 900;
}

.section-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 1.03rem;
}

.project-grid,
.experience-grid,
.leadership-grid {
  display: grid;
  gap: 24px;
}

.project-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.experience-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.leadership-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.card {
  padding: 30px;
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.white-section .card {
  background: #fbfbfc;
  box-shadow: none;
}

.card-kicker {
  margin: 0 0 10px;
  color: var(--rutgers-red);
  font-size: 0.78rem;
  font-weight: 850;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.card h3 {
  margin: 0 0 10px;
  color: var(--navy);
  font-size: 1.45rem;
  line-height: 1.18;
  letter-spacing: -0.025em;
}

.card p,
.card li {
  color: var(--muted);
}

.card p {
  margin: 0;
}

.role-line {
  margin-bottom: 14px !important;
  color: #4e5563 !important;
  font-weight: 700;
  font-size: 0.93rem;
}

.card ul {
  margin: 14px 0 0;
  padding-left: 20px;
}

.card li + li {
  margin-top: 7px;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin: 20px 0 16px;
}

.tag-row span {
  padding: 7px 11px;
  border-radius: 999px;
  background: #f1f2f5;
  color: #505766;
  font-size: 0.82rem;
  font-weight: 700;
}

.project-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  font-size: 0.92rem;
  font-weight: 800;
}

.project-links a:hover {
  color: var(--rutgers-red);
}

.contact-card {
  padding: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28px;
  background: var(--navy);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.contact-card h2 {
  margin: 0 0 8px;
  color: var(--white);
  font-size: clamp(1.9rem, 3vw, 2.8rem);
  letter-spacing: -0.04em;
}

.contact-card p {
  margin: 0;
  max-width: 650px;
  color: #cdd2de;
}

.contact-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.secondary-button {
  padding: 12px 20px;
  border: 1px solid rgba(255,255,255,0.22);
  color: var(--white);
}

.secondary-button.light {
  background: var(--white);
  color: var(--navy);
  border-color: var(--white);
}

.footer {
  padding: 25px 0 38px;
  color: #747b88;
  font-size: 0.9rem;
}

.footer-row {
  display: flex;
  justify-content: space-between;
  gap: 20px;
}

@media (max-width: 980px) {
  .hero-grid {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .profile-panel {
    max-width: 440px;
    margin: 0 auto;
  }

  .experience-grid {
    grid-template-columns: 1fr;
  }

  .project-grid,
  .leadership-grid {
    grid-template-columns: 1fr;
  }

  .contact-card {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 760px) {
  .container {
    width: min(var(--container), calc(100% - 28px));
  }

  .nav {
    min-height: auto;
    padding: 16px 0;
    align-items: flex-start;
  }

  .brand-title {
    display: none;
  }

  .nav-links {
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .nav-links > a:not(.resume-button) {
    display: none;
  }

  .resume-button {
    padding: 10px 15px;
    font-size: 0.86rem;
  }

  .hero {
    padding: 58px 0 72px;
  }

  .hero-copy h1 {
    font-size: clamp(2.7rem, 13vw, 4rem);
  }

  .section {
    padding: 68px 0;
  }

  .card,
  .contact-card {
    padding: 24px;
  }

  .footer-row {
    flex-direction: column;
  }
}
